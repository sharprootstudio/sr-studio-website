# ==============================================================================
# SR STUDIO — ENVIRONMENT VARIABLES SPECIFICATION & PLACEHOLDERS
# ==============================================================================
# IMPORTANT:
# 1. Never put real API keys, secrets, or passwords into this file or version control.
# 2. Variables prefixed with VITE_* are exposed to the browser.
# 3. Secret credentials must ONLY be set in the Supabase Dashboard / Edge Functions environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BROWSER / CLIENT-SIDE VARIABLES (Vite & Vercel Project Environment)
# ------------------------------------------------------------------------------

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Publishable Key (Safe for browser client with RLS enforced)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Public Lead Submission Endpoint (Defaults to your Supabase Edge Function URL)
# Example: https://your-project-id.supabase.co/functions/v1/submit-lead
VITE_LEAD_SUBMISSION_ENDPOINT=https://your-project-id.supabase.co/functions/v1/submit-lead

# Cloudflare Turnstile Site Key (Public widget key; leave blank if Turnstile is disabled)
VITE_TURNSTILE_SITE_KEY=

# Optional Direct Contact Form Endpoint Override (Legacy or testing fallback)
VITE_CONTACT_FORM_ENDPOINT=


# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (Supabase Dashboard -> Edge Functions / Vault Secrets)
# DO NOT EXPOSE TO BROWSER / DO NOT PREFIX WITH VITE_*
# ------------------------------------------------------------------------------

# Supabase Service Role Key (Used strictly inside Edge Function for trusted insert & bypass RLS)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Cloudflare Turnstile Secret Key (Server-side validation of visitor token)
# TURNSTILE_SECRET_KEY=0x4AAAAAA...your-turnstile-secret-key

# Resend API Key for Internal Email Alerts (https://resend.com)
# RESEND_API_KEY=re_123456789...

# Internal Notification Email Recipient (Agency inbox that receives lead alerts)
# NOTIFICATIONS_EMAIL_TO=sharprootstudio@gmail.com

# Verified Sending Email Address (Must be a domain verified in Resend, e.g. alerts@srstudio.agency)
# NOTIFICATIONS_EMAIL_FROM=SR Studio Alerts <inquiries@srstudio.agency>

# Meta WhatsApp Cloud API Credentials (https://developers.facebook.com)
# WHATSAPP_ACCESS_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_ALERT_RECIPIENT_PHONE=919876543210
# WHATSAPP_TEMPLATE_NAME=sr_studio_lead_alert

